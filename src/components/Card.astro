---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import readingTime from "reading-time";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog" | "grafty">;

const { variant: Heading = "h2", id, data, filePath, body, collection } = Astro.props;

const { title, description, ...props } = data;

const postPath = getPath(id, filePath, true, collection as "blog" | "grafty");

// Calculate reading time from full post body content
const readTimeMinutes = readingTime(body || description).minutes;
const readTimeText = `${Math.ceil(readTimeMinutes)} min read`;
---

<li class="my-6">
  <a
    href={postPath}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
    <Datetime {...props} />
    <span class="opacity-80">•</span>
    <span>{readTimeText}</span>
  </div>
  <p class="mt-1">{description}</p>
</li>
