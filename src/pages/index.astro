---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SOCIALS } from "@/constants";
import IconRss from "@/assets/icons/IconRss.svg";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-6 pb-4">
      <div class="max-w-2xl">

        <!-- Profile row: circular photo + blurb -->
        <div class="profile-row">
          <img 
            src="/ibby2.png" 
            alt="Ibby" 
            class="profile-avatar"
          />
          <div class="profile-intro">
            <h1 class="text-3xl font-bold mb-3 sm:text-4xl">
              Hi, I'm Ibby
            </h1>
            <p class="text-base text-muted-foreground leading-relaxed mb-4">
              No CS degree. No Plan. Just a cheap VPS, some API keys and a couple of LLM's keeping the hopium going.
            </p>
            <div class="social-links">
              {SOCIALS.map((social) => (
                <a 
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-link"
                  title={social.linkTitle}
                >
                  <social.icon class="w-5 h-5" />
                  <span class="sr-only">{social.linkTitle}</span>
                </a>
              ))}
              <a 
                href="/rss.xml"
                class="social-link"
                title="RSS Feed"
              >
                <IconRss class="w-5 h-5" />
                <span class="sr-only">RSS Feed</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom orange line -->
        <div class="orange-line"></div>

      </div>
    </section>

    <!-- Posts -->
    <section id="posts" class="pt-6 pb-12">
      <ul class="space-y-6">
        {sortedPosts.map((post) => (
          <Card {...post} variant="h3" />
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<style>
  .orange-line {
    width: 100%;
    height: 1px;
    background: #ff6b01;
    margin-top: 1rem;
  }

  .profile-row {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: right center;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .profile-intro {
    flex: 1;
  }

  .profile-intro h1 {
    margin-bottom: 0.4rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    color: var(--foreground);
    opacity: 0.6;
    transition: opacity 0.2s, color 0.2s;
    border-radius: 4px;
  }

  .social-link:hover {
    opacity: 1;
    color: #ff6b01;
  }

  @media (max-width: 480px) {
    .profile-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .profile-avatar {
      width: 90px;
      height: 90px;
    }
  }
</style>
