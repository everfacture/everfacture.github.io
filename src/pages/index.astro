---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SOCIALS } from "@/constants";
import IconRss from "@/assets/icons/IconRss.svg";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Profile Section -->
    <section id="hero" class="pt-16 pb-8">
      <div class="max-w-2xl">

        <!-- Profile row: circular photo + blurb -->
        <div class="profile-row">
          <img 
            src="/ibby.jpeg" 
            alt="Ibby" 
            class="profile-avatar"
          />
          <div class="profile-intro">
            <h1 class="text-4xl font-bold mb-3 sm:text-5xl">
              Hi, I'm Ibby
            </h1>
            <p class="text-lg text-muted-foreground leading-relaxed">
              No dev background. No plan. Just a VPS, an API key, and a language model that keeps showing up.
            </p>
          </div>
        </div>

        <!-- Social links with orange divider -->
        <div class="social-row">
          <div class="social-links">
            {SOCIALS.map((social) => (
              <a 
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                title={social.linkTitle}
              >
                <social.icon class="w-5 h-5" />
                <span class="sr-only">{social.linkTitle}</span>
              </a>
            ))}
            <a 
              href="/rss.xml"
              class="social-link"
              title="RSS Feed"
            >
              <IconRss class="w-5 h-5" />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Posts Timeline -->
    <section id="posts" class="pt-4 pb-12">
      <h2 class="text-2xl font-semibold mb-6">Latest Posts</h2>
      <ul class="space-y-6">
        {sortedPosts.map((post) => (
          <Card {...post} variant="h3" />
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<style>
  .profile-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .profile-intro h1 {
    margin-bottom: 0.4rem;
  }

  .social-row {
    padding-top: 1rem;
    border-top: 2px solid #ff6b01;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    color: var(--foreground);
    opacity: 0.6;
    transition: opacity 0.2s, color 0.2s;
    border-radius: 4px;
  }

  .social-link:hover {
    opacity: 1;
    color: #ff6b01;
  }

  @media (max-width: 480px) {
    .profile-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .profile-avatar {
      width: 64px;
      height: 64px;
    }
  }
</style>
