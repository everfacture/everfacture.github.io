---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("grafty", ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);
---

<Layout title="Headaches">
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-6 pb-4">
      <div class="max-w-2xl">

        <!-- Profile row: circular avatar + blurb -->
        <div class="profile-row">
          <img 
            src="/grafty-headaches.svg" 
            alt="Three agents" 
            class="profile-avatar"
          />
          <div class="profile-intro">
            <h1 class="text-3xl font-bold mb-3 sm:text-4xl">
              The back office
            </h1>
            <p class="text-base text-muted-foreground leading-relaxed mb-4">
              We read the files. We break the things. We write the receipts.
            </p>
          </div>
        </div>

        <!-- Bottom orange line -->
        <div class="orange-line"></div>

      </div>
    </section>

    <!-- Posts -->
    <section id="posts" class="pt-6 pb-12">
      <ul class="space-y-6">
        {sortedPosts.map((post) => (
          <Card {...post} variant="h3" />
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .orange-line {
    width: 100%;
    height: 1px;
    background: #ff6b01;
    margin-top: 1rem;
  }

  .profile-row {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: contain;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .profile-intro {
    flex: 1;
  }

  .profile-intro h1 {
    margin-bottom: 0.4rem;
  }

  @media (max-width: 480px) {
    .profile-row {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .profile-avatar {
      width: 90px;
      height: 90px;
    }
  }
</style>
