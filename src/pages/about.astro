---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`About | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="app-prose mb-28">

      <!-- About Grid: photo left, content right -->
      <div class="about-grid">
        <aside class="about-left">
          <div class="photo-placeholder">
            <span>Photo</span>
          </div>
          <a 
            href="https://github.com/everfacture" 
            class="github-link"
            target="_blank" 
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="gh-icon">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            github.com/everfacture
          </a>
        </aside>

        <div class="about-right">
          <p>
            Building trading bots and tools that solve my problems. Based in Surabaya, Indonesia.
          </p>
          <p>
            After years of side projects and vibe-coding, I went all-in on AI-assisted development with OpenClaw.
            Lost money on API credits, wiped a VPS with an errant command at 1 AM, and kept building.
          </p>
          <p>
            I build what I need and ship it.
          </p>
        </div>
      </div>

      <hr class="section-divider" />

      <!-- GitHub Activity -->
      <section class="content-section">
        <h2>GitHub Activity</h2>
        <p class="section-desc">
          I build what I need and release it all as open source.
        </p>
        <div class="github-chart">
          <a href="https://github.com/everfacture" target="_blank" rel="noopener">
            <img 
              src="https://ghchart.rshah.org/22c55e/everfacture" 
              alt="GitHub contribution chart for everfacture"
              width="900"
            />
          </a>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- Projects -->
      <section class="content-section">
        <h2>Projects</h2>
        <ul class="projects-list">
          <li>
            <a href="https://github.com/everfacture/katar" target="_blank" rel="noopener">Katar</a>
            — Lean automated execution for structural arbitrage
          </li>
          <li>
            <a href="https://github.com/everfacture/whisper-puma" target="_blank" rel="noopener">Whisper Puma</a>
            — Unlimited local voice dictation for macOS
          </li>
          <li>
            <a href="https://github.com/everfacture/pulse-bpm-app" target="_blank" rel="noopener">Pulse BPM</a>
            — Beat per minute detector
          </li>
          <li>
            <a href="https://github.com/everfacture/mufc-lineup-bot" target="_blank" rel="noopener">MUFC Lineup Bot</a>
            — Manchester United team news
          </li>
        </ul>
      </section>

    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;
    padding-top: 1.5rem;
  }

  .about-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .photo-placeholder {
    width: 220px;
    height: 220px;
    background: linear-gradient(135deg, #2a3f47 0%, #1a2830 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5a6e73;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: #6b7c80;
    text-decoration: none;
    transition: color 0.2s;
  }

  .github-link:hover {
    color: #22c55e;
  }

  .gh-icon {
    width: 16px;
    height: 16px;
  }

  .about-right p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--foreground);
  }

  .about-right p:last-child {
    margin-bottom: 0;
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .content-section {
    margin-bottom: 0;
  }

  .content-section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    color: var(--foreground);
    opacity: 0.7;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .github-chart {
    border-radius: 8px;
    overflow: hidden;
    background: var(--muted);
    padding: 0.5rem;
    display: inline-block;
  }

  .github-chart img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .github-chart a:hover {
    opacity: 0.9;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects-list li {
    margin-bottom: 0.6rem;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .projects-list a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .projects-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .photo-placeholder {
      width: 160px;
      height: 160px;
    }

    .about-left {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }
</style>
